{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 20,
            "statusMessage": "Checking Codex RTL support"
          }
        ]
      }
    ]
  }
}
