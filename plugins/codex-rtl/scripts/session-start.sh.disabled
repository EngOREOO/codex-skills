#!/bin/bash
set -u

PLUGIN_DIR="${PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
NODE_BIN="${NODE_BIN:-$(command -v node 2>/dev/null || true)}"

if [ -z "$NODE_BIN" ]; then
  exit 0
fi

"$NODE_BIN" "$PLUGIN_DIR/scripts/install-autostart.mjs" --quiet >/tmp/codex-rtl-autostart.log 2>&1 || true
exit 0
